  "bindings": {
    "schemaVersion": 1,
    "tasks": {
      "acme-user/acme-maintenance/sync": {
        "name": "AcmeUserSync",
        "enabled": false,
        "argv": [
          "C:/Acme/runtime/python.exe",
          "C:/Acme/source/sync.py",
