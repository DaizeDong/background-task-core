          "type": "daily",
          "at": "03:15"
        },
        "principal": {
          "user_id": "AcmeService",
          "logon_type": "InteractiveToken",
          "run_level": "LeastPrivilege"
        },
        "power": {
          "disallow_start_on_batteries": true,
          "stop_on_batteries": false,
          "wake_to_run": false
        },
        "timeout_seconds": 420,
        "concurrency": {
          "policy": "IgnoreNew"
        },
        "source_root": "C:/Acme/source",
        "backup": true,
        "category": "maintenance",
        "checks": [
          {
            "id": "output",
            "legacy": {
              "label": "Synthetic output",
              "max_age_hours": 26,
              "artifact": "C:/Acme/data/output.json",
              "ok_exit_codes": [
                0,
