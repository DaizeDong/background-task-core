{
  "schemaVersion": 1,
  "components": [
    {
      "namespace": "acme-user",
      "manifest": {
        "schemaVersion": 1,
        "component": "acme-maintenance",
        "read": "acme-status",
        "tasks": [
          {
            "id": "sync",
            "kind": "oneshot",
            "entrypoint": "acme-sync",
            "schedule_hint": {
              "type": "interval",
              "minutes": 60
            },
            "timeout_seconds": 300,
            "concurrency_key": "acme-destination",
            "checks": [
              {
                "id": "output",
                "required": true
              },
              {
                "id": "dependencies",
                "required": false
              }
            ]
          }
        ]
      }
    },
    {
      "namespace": "acme-project",
      "manifest": {
        "schemaVersion": 1,
        "component": "acme-maintenance",
